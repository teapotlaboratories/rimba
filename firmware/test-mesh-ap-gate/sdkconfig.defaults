# rimba-halow-mesh-ap app config (layered on top of boards/<BOARD>/ defaults).
# Mesh AND SoftAP share the AP-type interface + BSS_CONFIG/beacon code path, so
# the AP-mode morselib sources must be compiled in.
CONFIG_HALOW_AP_MODE=y

# All-ESP Mesh-gate routes between the AP subnet (192.168.12.0/24) and the mesh
# subnet (10.9.9.0/24) via two esp_netifs — lwIP must forward between them.
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=n

# 2 MB app partition — the stage-1b arm (HW_RESTART=1) overflows SINGLE_APP_LARGE. See partitions.csv
# for why it applies to both arms.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
